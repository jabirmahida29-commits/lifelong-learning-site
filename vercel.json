{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "lifelonglearningcentre.com" }],
      "destination": "https://www.lifelonglearningcentre.com/$1",
      "statusCode": 301
    },
    { "source": "/about/", "destination": "/about", "statusCode": 301 },
    { "source": "/contact-us", "destination": "/#contact", "statusCode": 301 },
    { "source": "/contact-us/", "destination": "/#contact", "statusCode": 301 },
    { "source": "/gallery", "destination": "/", "statusCode": 301 },
    { "source": "/gallery/", "destination": "/", "statusCode": 301 },
    { "source": "/programs/", "destination": "/programs", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
